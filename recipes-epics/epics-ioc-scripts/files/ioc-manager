# Convenience front end over the instance registry and systemd, in the spirit
# of NSLS2's manage-iocs. Reads the same two registry layers as the runtime
# (fleet: /etc/epics/instances, machine: /boot/iocs) and drives
# systemctl for the epics-ioc@ instances.

set -e

HERE="$(cd "$(dirname "$0")" && pwd)"
RUNTIME=/usr/libexec/epics-ioc
[ -r "$RUNTIME/epics-ioc-env" ] || { echo "$0: missing $RUNTIME/epics-ioc-env" >&2; exit 1; }
. "$RUNTIME/epics-ioc-env"

usage() {
    echo "Usage: $0 <command> [args]"
    echo "  list             instances from both registry layers, with state"
    echo "  report [name]    name / slot / console port / prefix / application"
    echo "  status [name]    systemctl status for one or all instances"
    echo "  startall         start every registered instance"
    echo "  stopall          stop every registered instance"
    exit 2
}

# Print "name layer" for every known instance; the machine layer wins.
registry_entries() {
    _seen=""
    for _f in "$ENV_ROOT"/*.env "$MACHINE_ENV_ROOT"/*.env; do
        [ -f "$_f" ] || continue
        _name=$(basename "$_f" .env)
        case "$_seen" in
            *" $_name "*) ;;
            *) _seen="$_seen $_name "; echo "$_name $( [ "${_f#"$MACHINE_ENV_ROOT"/}" != "$_f" ] && echo machine || echo fleet )" ;;
        esac
    done
}

entries() {
    registry_entries | cut -d' ' -f1
}

slot_and_port() {
    # $1 = instance name; prints "slot port" (slot defaults to 0)
    _slot=0
    for _f in "$MACHINE_ENV_ROOT/$1.env" "$ENV_ROOT/$1.env"; do
        [ -f "$_f" ] && _slot=$(sed -n 's/^[[:space:]]*IOC_INSTANCE_INDEX=[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$_f" | tail -n 1)
        [ -n "$_slot" ] && break
    done
    _slot=${_slot:-0}
    echo "$_slot $(( PORT_BASE + _slot * 10 ))"
}

cmd=${1:-}
[ -n "$cmd" ] || usage

case "$cmd" in
    list)
        printf "%-16s %-8s %-9s %s\n" INSTANCE LAYER ENABLED ACTIVE
        registry_entries | while read -r name layer; do
            printf "%-16s %-8s %-9s %s\n" "$name" "$layer" \
                "$(systemctl is-enabled "epics-ioc@$name.service" 2>/dev/null || echo -)" \
                "$(systemctl is-active "epics-ioc@$name.service" 2>/dev/null || echo inactive)"
        done
        ;;
    report)
        if [ -n "$2" ]; then
            _names="$2"
        else
            _names=$(entries)
        fi
        printf "%-16s %-5s %-7s %-16s %s\n" INSTANCE SLOT PORT PREFIX APP
        for name in $_names; do
            set -- $(slot_and_port "$name")
            _prefix=
            _app=
            for _f in "$ENV_ROOT/$name.env" "$MACHINE_ENV_ROOT/$name.env"; do
                [ -f "$_f" ] || continue
                _prefix=$(sed -n 's/^[[:space:]]*IOC_PREFIX=[[:space:]]*//p' "$_f" | tail -n 1)
                _app=$(sed -n 's/^[[:space:]]*IOC_APP_DIR=[[:space:]]*//p' "$_f" | tail -n 1)
            done
            printf "%-16s %-5s %-7s %-16s %s\n" "$name" "$1" "$2" "${_prefix:--}" "${_app:--}"
        done
        ;;
    status)
        [ -n "$2" ] && exec systemctl status "epics-ioc@$2.service"
        for name in $(entries); do
            printf "%-16s %s\n" "$name" "$(systemctl is-active "epics-ioc@$name.service" 2>/dev/null || echo inactive)"
        done
        ;;
    startall)
        for name in $(entries); do
            echo "starting $name"
            systemctl start "epics-ioc@$name.service"
        done
        ;;
    stopall)
        for name in $(entries); do
            echo "stopping $name"
            systemctl stop "epics-ioc@$name.service"
        done
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "unknown command: $cmd" >&2
        usage
        ;;
esac
