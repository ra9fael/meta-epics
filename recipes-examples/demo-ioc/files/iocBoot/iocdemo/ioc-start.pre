# Sourced by the generated ioc-start.sh, after the ports are resolved and after
# cd into the IOC boot directory. Not executed directly.
#
# start_sim_device stands in for a real device: socat listens on this
# instance's APP_PORT_1 and echoes every line back through echo.sh. It runs as
# a sibling process in the service's cgroup, so systemd stops it together with
# the IOC.

start_sim_device() {
    socat -d -d "TCP-LISTEN:$APP_PORT_1,reuseaddr,fork" EXEC:"./echo.sh" &
}
