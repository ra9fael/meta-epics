# Demo records for the asyn data path.
#
# $(P)cmdset holds the command sent to the asyn port. $(P)cmd uses the
# asynOctetWriteRead device support: on each process it reads the command from
# the record named in INP, writes it followed by the output EOS, then reads
# until the input EOS and stores the response in VAL.
#
#   caput <P>cmdset world
#   dbpf   <P>cmd.PROC 1
#   caget  <P>cmd            -> world

record(stringout, "$(P)cmdset") {
    field(VAL,  "hello")
    field(SCAN, "Passive")
}

record(stringin, "$(P)cmd") {
    field(DTYP, "asynOctetWriteRead")
    field(INP,  "@asyn(L0)$(P)cmdset")
    field(SCAN, "Passive")
}
