# Demo instance 1. IOC_INSTANCE_INDEX selects the 10-port stride out of the
# epics-demo-ioc block (21000-21099), so this instance uses
#   PS_PORT=21000  APP_PORT_1=21001  APP_PORT_2=21002
IOC_INSTANCE_INDEX=0
IOC_PREFIX=ioc1:
IOC_STATE=/var/lib/epics-demo-ioc/ioc1
