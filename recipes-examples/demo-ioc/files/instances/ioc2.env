# Demo instance 2. IOC_INSTANCE_INDEX=1 selects the next 10-port stride, so
# this instance uses
#   PS_PORT=21010  APP_PORT_1=21011  APP_PORT_2=21012
# It therefore does not collide with ioc1 even though both serve PVs from the
# same CA port on the same host.
IOC_INSTANCE_INDEX=1
IOC_PREFIX=ioc2:
IOC_STATE=/var/lib/epics-demo-ioc/ioc2
